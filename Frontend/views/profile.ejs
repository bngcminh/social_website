<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profileUser.username %> - Profile</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/profile.css">
  <link rel="stylesheet" href="/public/css/profile-modal.css">
</head>
<body>
<div class="wrap">
  <%- include('_header') %>
  <div class="main">
    <div class="feed">
      <!-- Header -->
      <div class="profile-header">
        <div class="profile-header-top">
          <a href="/" class="back-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 11H7.83l5.59-5.59L12 3l-9 9 9 9 1.41-1.41L7.83 13H19v-2z"></path>
            </svg>
          </a>
          <div class="profile-header-info">
            <h2 class="profile-username"><%= profileUser.username %></h2>
            <div class="profile-posts-count"><%= posts.length %> bài viết</div>
          </div>
        </div>
      </div>

      <!-- Cover Image & Avatar -->
      <div class="profile-banner">
        <% if (profileUser.coverImage) { %>
          <img src="<%= profileUser.coverImage %>" alt="Cover" class="cover-image">
        <% } else { %>
          <div class="cover-image-placeholder"></div>
        <% } %>
      </div>

      <!-- Profile Info -->
      <div class="profile-info">
        <div class="profile-info-top">
          <div class="profile-avatar">
            <% if (profileUser.avatar) { %>
              <img src="<%= profileUser.avatar %>" alt="Avatar">
            <% } else { %>
              <div class="avatar"><%= profileUser.username.substring(0, 1).toUpperCase() %></div>
            <% } %>
          </div>
          <% if (isOwnProfile) { %>
            <button class="edit-profile-btn" onclick="editProfile()">Sửa hồ sơ</button>
          <% } else if (user) { %>
            <div class="profile-actions" style="display:flex;gap:8px">
              <button class="follow-btn" id="follow-btn" onclick="toggleFollow('<%= profileUser._id %>')">
                <%= isFollowing ? 'Đang theo dõi' : 'Theo dõi' %>
              </button>
              <button class="follow-btn" onclick="startChat('<%= profileUser._id %>')">
                  Nhắn tin
              </button>
            </div>
          <% } %>
        </div>
        <div class="profile-names">
          <div class="full-name"><%= profileUser.username %></div>
          <div class="username">@<%= profileUser.username %></div>
        </div>
        <% if (profileUser.bio) { %>
          <div class="profile-bio"><%= profileUser.bio %></div>
        <% } %>

        <div class="profile-meta">
          <% if (profileUser.location) { %>
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path>
              </svg>
              <%= profileUser.location %>
            </div>
          <% } %>
          <% if (profileUser.website) { %>
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path>
              </svg>
              <a href="<%= profileUser.website %>" target="_blank"><%= profileUser.website %></a>
            </div>
          <% } %>
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 4h-2V2h-2v2H9V2H7v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2M5 20V8h14v12z"></path>
            </svg>
            Tham gia <%= new Date(profileUser.createdAt).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long' }) %>
          </div>
        </div>

        <div class="profile-stats">
          <div class="stat stat-following">
            <span class="stat-count"><%= profileUser.followingCount %></span>
            <span class="stat-label">Đang theo dõi</span>
          </div>
          <div class="stat stat-followers">
            <span class="stat-count"><%= profileUser.followersCount %></span>
            <span class="stat-label">Người theo dõi</span>
          </div>
        </div>
      </div>
      <!-- Tabs -->
      <div class="profile-tabs">
        <div class="tab active">
          <button class="tab-button" data-tab="posts" onclick="switchTab(this)">
            <span>Bài viết</span>
          </button>
        </div>
        <div class="tab">
          <button class="tab-button" data-tab="likes" onclick="switchTab(this)">
            <span>Thích</span>
          </button>
        </div>
        <div class="tab">
          <button class="tab-button" data-tab="replies" onclick="switchTab(this)">
            <span>Trả lời</span>
          </button>
        </div>
        <div class="tab">
          <button class="tab-button" data-tab="reposts" onclick="switchTab(this)">
            <span>Đăng lại</span>
          </button>
        </div>
      </div>
      <!-- Posts -->
      <div class="profile-posts">
        <% if (posts.length > 0) { %>
          <% posts.forEach(post => { %>
            <div class="post" data-post-id="<%= String(post._id) %>" onclick="(function(e){ if(!e.target.closest('.tweet-actions') && !e.target.closest('.post-menu')) window.location.href='/post/<%= post._id %>'; })(event)">
              <div class="post-left">
                <div class="avatar">
                  <% if (post.author.avatar) { %>
                    <img src="<%= post.author.avatar %>" alt="<%= post.author.username %>">
                  <% } else { %>
                    <%= post.author.username.substring(0, 1).toUpperCase() %>
                  <% } %>
                </div>
              </div>
              <div class="post-right">
                <div class="post-header">
                  <div class="tweet-user">
                    <span class="post-author"><%= post.author.username %></span>
                    <span class="post-handle">@<%= post.author.username %></span>
                    <span class="post-time"> · <%= new Date(post.createdAt).toLocaleDateString('vi-VN') %></span>
                  </div>
                  <div class="tweet-options">
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1xvli5t r-1hdv0qi"><g><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></g></svg>
                  </div>
                  <% if (user && user._id === post.author._id) { %>
                    <div class="post-menu">
                      <button class="menu-btn" onclick="togglePostMenu(this)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path>
                        </svg>
                      </button>
                      <div class="post-menu-dropdown">
                        <button onclick="editPost('<%= post._id %>')">Chỉnh sửa</button>
                        <button onclick="deletePost('<%= post._id %>')" style="color: #d32f2f;">Xóa</button>
                      </div>
                    </div>
                  <% } %>
                </div>
                <div class="post-content">
                  <%= post.content %>
                </div>
                <% if (post.media && post.media.length > 0) { %>
                  <div class="post-media">
                    <% post.media.forEach(media => { %>
                      <% if (media.type === 'image') { %>
                        <img src="<%= media.url %>" alt="Post image" style="border-radius: 16px;">
                      <% } else if (media.type === 'video') { %>
                        <video src="<%= media.url %>" controls style="border-radius: 16px; max-width: 100%;"></video>
                      <% } %>
                    <% }); %>
                  </div>
                <% } %>
                <div class="tweet-actions">
                  <button class="act reply" data-action="reply">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.25em;height:1.25em;display:inline-block;fill:currentColor;vertical-align:text-bottom"><g><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"></path></g></svg>
                    <span class="count"><%= post.commentCount || 0 %></span>
                  </button>
                  <button class="act retweet" data-action="retweet">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.25em;height:1.25em;display:inline-block;fill:currentColor;vertical-align:text-bottom"><g><path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"></path></g></svg>
                    <span class="count"><%= post.repostCount || 0 %></span>
                  </button>
                  <button class="act like" data-action="like">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.25em;height:1.25em;display:inline-block;fill:currentColor;vertical-align:text-bottom"><g><path d="M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z"></path></g></svg>
                    <span class="count"><%= post.likeCount || 0 %></span>
                  </button>
                  <button class="act views" data-action="views">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.25em;height:1.25em;display:inline-block;fill:currentColor;vertical-align:text-bottom"><g><path d="M8.75 21V3h2v18h-2zM18 21V8.5h2V21h-2zM4 21l.004-10h2L6 21H4zm9.248 0v-7h2v7h-2z"></path></g></svg>
                    <span class="count"><%= post.viewsCount || 0 %></span>
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"></path>
            </svg>
            <p>Chưa có bài viết nào</p>
          </div>
        <% } %>
      </div>
    </div>

    <div class="right-col">
      <div class="right-col-content">
        <div class="search-box">
          <div class="search-title">
            <div class="search-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><g><path d="M10.25 3.75c-3.59 0-6.5 2.91-6.5 6.5s2.91 6.5 6.5 6.5c1.795 0 3.419-.726 4.596-1.904 1.178-1.177 1.904-2.801 1.904-4.596 0-3.59-2.91-6.5-6.5-6.5zm-8.5 6.5c0-4.694 3.806-8.5 8.5-8.5s8.5 3.806 8.5 8.5c0 1.986-.682 3.815-1.824 5.262l4.781 4.781-1.414 1.414-4.781-4.781c-1.447 1.142-3.276 1.824-5.262 1.824-4.694 0-8.5-3.806-8.5-8.5z"></path></g></svg>
            </div>
            <input type="text" placeholder="Tìm kiếm">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Profile Modal -->
<div id="edit-profile-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <button class="modal-close" onclick="closeEditProfile()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
        </svg>
      </button>
      <h2 class="modal-title">Edit profile</h2>
      <button class="modal-save-btn" onclick="saveProfile()">Save</button>
    </div>

    <div class="modal-body">
      <!-- Avatar Section -->
      <div class="modal-avatar-section">
        <div class="modal-avatar">
          <% if (profileUser.avatar) { %>
            <img id="avatar-preview" src="<%= profileUser.avatar %>" alt="Avatar">
          <% } else { %>
            <div id="avatar-preview" class="avatar"><%= profileUser.username.substring(0, 1).toUpperCase() %></div>
          <% } %>
        </div>
        <button class="edit-photo-btn" onclick="editPhoto()">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"></path>
          </svg>
          Edit Photo
        </button>
      </div>

      <!-- Form Fields -->
      <div class="modal-form">
        <div class="form-group">
          <label>Name</label>
          <input type="text" id="edit-name" placeholder="Your name" value="<%= profileUser.username %>">
        </div>

        <div class="form-group">
          <label>Bio</label>
          <textarea id="edit-bio" placeholder="Tell people about yourself" rows="3"><%= profileUser.bio || '' %></textarea>
        </div>

        <div class="form-group">
          <label>Location</label>
          <input type="text" id="edit-location" placeholder="Where are you from?" value="<%= profileUser.location || '' %>">
        </div>

        <div class="form-group">
          <label>Website</label>
          <input type="text" id="edit-website" placeholder="Your website" value="<%= profileUser.website || '' %>">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Hidden file input for avatar upload -->
<input type="file" id="avatar-file-input" style="display: none;" accept="image/*" onchange="handleAvatarUpload(event)">
<script>
  const profileUsername = '<%= profileUser.username %>';
</script>
<script src="/public/js/profile.js"></script>
</body>
</html>
