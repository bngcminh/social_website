<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tin Nhắn - Social Media</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/messages.css">
</head>
<body>
<div class="wrap-messages">
  <header class="sidebar-messages sidebar">
    <div class="sidebar-top sidebar-top-messages">
      <div class="logo">
        <a href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-lrsllp r-1nao33i r-16y2uox r-8kz0gk"><g><path d="M21.742 21.75l-7.563-11.179 7.056-8.321h-2.456l-5.691 6.714-4.54-6.714H2.359l7.29 10.776L2.25 21.75h2.456l6.035-7.118 4.818 7.118h6.191-.008zM7.739 3.818L18.81 20.182h-2.447L5.29 3.818h2.447z"></path></g></svg>
        </a>
      </div>
      <div class="nav">
        <a class="nav-item active" href="/">
          <div class="nav-item-content" >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1nao33i r-lwhw9o r-cnnz9e"><g><path d="M10.059 2.593c1.175-.784 2.707-.784 3.882 0l6.5 4.333C21.415 7.575 22 8.668 22 9.838V18.5c0 1.933-1.567 3.5-3.5 3.5h-4.25v-5.25c0-1.243-1.007-2.25-2.25-2.25s-2.25 1.007-2.25 2.25V22H5.5C3.567 22 2 20.433 2 18.5V9.838c0-1.17.585-2.263 1.559-2.912l6.5-4.333z"></path></g></svg>
          </div>
        </a>
        <a class="nav-item active" href="/explore">
          <div class="nav-item-content">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1nao33i r-lwhw9o r-cnnz9e"><g><path d="M10.25 3.75c-3.59 0-6.5 2.91-6.5 6.5s2.91 6.5 6.5 6.5c1.795 0 3.419-.726 4.596-1.904 1.178-1.177 1.904-2.801 1.904-4.596 0-3.59-2.91-6.5-6.5-6.5zm-8.5 6.5c0-4.694 3.806-8.5 8.5-8.5s8.5 3.806 8.5 8.5c0 1.986-.682 3.815-1.824 5.262l4.781 4.781-1.414 1.414-4.781-4.781c-1.447 1.142-3.276 1.824-5.262 1.824-4.694 0-8.5-3.806-8.5-8.5z"></path></g></svg>
          </div>
        </a>
        <a class="nav-item active" href="/notifications">
          <div class="nav-item-content">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1nao33i r-lwhw9o r-cnnz9e"><g><path d="M19.993 9.042C19.48 5.017 16.054 2 11.996 2s-7.49 3.021-7.999 7.051L2.866 18H7.1c.463 2.282 2.481 4 4.9 4s4.437-1.718 4.9-4h4.236l-1.143-8.958zM12 20c-1.306 0-2.417-.835-2.829-2h5.658c-.412 1.165-1.523 2-2.829 2zm-6.866-4l.847-6.698C6.364 6.272 8.941 4 11.996 4s5.627 2.268 6.013 5.295L18.864 16H5.134z"></path></g></svg>
          </div>
        </a>
        <a href="/messages" class="nav-item active">
          <div class="nav-item-content">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1nao33i r-lwhw9o r-cnnz9e"><g><path d="M20.7 11.7c0-4.48-3.844-8.2-8.699-8.2-4.854 0-8.698 3.72-8.698 8.2v.015l-.001.014c-.02.667.09 1.225.25 1.767.083.28.176.545.276.839.098.285.202.595.288.918.177.663.284 1.401.156 2.271-.086.582-.274 1.191-.582 1.855 1.264.375 2.55.053 4.013-.599l.455-.203.437.242c1.07.594 1.917 1.08 3.406 1.08 4.855 0 8.7-3.72 8.7-8.199zm2 0c0 5.683-4.84 10.2-10.699 10.2-1.784 0-2.96-.555-3.95-1.095-1.876.768-4.02 1.2-6.245-.075l-.885-.505.524-.875c.54-.904.77-1.581.848-2.118.078-.526.02-.98-.11-1.463-.066-.25-.15-.502-.247-.788-.095-.277-.204-.59-.301-.92-.199-.674-.36-1.449-.332-2.39C1.322 6.002 6.154 1.5 12.002 1.5c5.859 0 10.7 4.518 10.7 10.2z"></path></g></svg>
          </div>
        </a>
        <% if (user) { %>
          <a href="/profile/<%= user.username %>" class="nav-item active">
            <div class="nav-item-content">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1nao33i r-lwhw9o r-cnnz9e"><g><path d="M5.651 19h12.698c-.337-1.8-1.023-3.21-1.945-4.19C15.318 13.65 13.838 13 12 13s-3.317.65-4.404 1.81c-.922.98-1.608 2.39-1.945 4.19zm.486-5.56C7.627 11.85 9.648 11 12 11s4.373.85 5.863 2.44c1.477 1.58 2.366 3.8 2.632 6.46l.11 1.1H3.395l.11-1.1c.266-2.66 1.155-4.88 2.632-6.46zM12 4c-1.105 0-2 .9-2 2s.895 2 2 2 2-.9 2-2-.895-2-2-2zM8 6c0-2.21 1.791-4 4-4s4 1.79 4 4-1.791 4-4 4-4-1.79-4-4z"></path></g></svg>
            </div>
          </a>
        <% } %>
        <a class="nav-item active" href="/bookmarks">
          <div class="nav-item-content">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1nao33i r-lwhw9o r-cnnz9e"><g><path d="M3.75 12c0-4.56 3.69-8.25 8.25-8.25s8.25 3.69 8.25 8.25-3.69 8.25-8.25 8.25S3.75 16.56 3.75 12zM12 1.75C6.34 1.75 1.75 6.34 1.75 12S6.34 22.25 12 22.25 22.25 17.66 22.25 12 17.66 1.75 12 1.75zm-4.75 11.5c.69 0 1.25-.56 1.25-1.25s-.56-1.25-1.25-1.25S6 11.31 6 12s.56 1.25 1.25 1.25zm9.5 0c.69 0 1.25-.56 1.25-1.25s-.56-1.25-1.25-1.25-1.25.56-1.25 1.25.56 1.25 1.25 1.25zM13.25 12c0 .69-.56 1.25-1.25 1.25s-1.25-.56-1.25-1.25.56-1.25 1.25-1.25 1.25.56 1.25 1.25z"></path></g></svg>
          </div>
        </a>
        <div class="nav-item-content">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1472mwg r-lrsllp" style="color: rgb(15, 20, 25);"><g><path d="M10.938 4.5H9.9c-1.136 0-1.929 0-2.546.05-.605.05-.953.143-1.216.277-.564.288-1.023.747-1.31 1.31-.135.264-.228.612-.277 1.218C4.5 7.97 4.5 8.765 4.5 9.9v4.2c0 1.136 0 1.929.05 2.546.05.605.143.953.277 1.216.288.565.747 1.023 1.31 1.31.264.135.612.228 1.217.277.617.05 1.41.051 2.546.051h4.2c1.136 0 1.929 0 2.545-.05.606-.05.954-.143 1.217-.277.565-.288 1.023-.746 1.31-1.31.135-.264.228-.612.277-1.217.05-.617.051-1.41.051-2.546v-1.037h2V14.1c0 1.103.001 1.992-.058 2.709-.06.728-.185 1.368-.487 1.96-.48.941-1.245 1.707-2.185 2.186-.593.302-1.233.428-1.961.488-.718.058-1.606.057-2.71.057H9.9c-1.103 0-1.991.001-2.709-.058-.728-.06-1.368-.185-1.96-.487-.941-.48-1.707-1.245-2.186-2.185-.302-.593-.428-1.233-.487-1.961-.059-.718-.058-1.606-.058-2.71V9.9c0-1.103-.001-1.991.058-2.709.06-.728.185-1.368.487-1.96.48-.941 1.245-1.707 2.185-2.186.593-.302 1.233-.428 1.961-.487.718-.059 1.606-.058 2.71-.058h1.037v2z"></path><path clip-rule="evenodd" d="M16.293 3.293c1.219-1.219 3.195-1.219 4.414 0 1.219 1.219 1.219 3.195 0 4.414l-5.491 5.491c-.533.533-.89.896-1.31 1.179-.356.24-.742.433-1.148.574-.478.167-.983.234-1.729.341l-2.708.387.387-2.708c.107-.746.174-1.25.34-1.729.142-.405.335-.792.575-1.148.283-.42.646-.777 1.179-1.31l5.491-5.491zm3 1.414c-.438-.438-1.148-.438-1.586 0l-5.491 5.491c-.587.587-.784.79-.934 1.013-.144.214-.26.445-.345.688-.088.254-.131.533-.248 1.354l-.01.067.068-.008c.82-.118 1.1-.161 1.354-.25.243-.084.474-.2.688-.344.223-.15.426-.347 1.013-.934l5.491-5.491c.438-.438.438-1.148 0-1.586z" fill-rule="evenodd"></path></g></svg>
        </div>
      </div>
    </div>
    <div class="sidebar-bottom sidebar-bottom-messages">
      <% if (user) { %>
        <button class="user-btn">
          <div class="avatar">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" style="width:100%;height:100%;border-radius:50%;object-fit:cover">
            <% } else { %>
              <%= user.username.substring(0, 1).toUpperCase() %>
            <% } %>
          </div>
        </button>
      <% } else { %>
        <a href="/auth" class="tweet-btn" style="width:100%">
          <span>Đăng Nhập</span>
        </a>
      <% } %>
    </div>
  </header>
  
  <div class="main-messages">
    <div class="messages-wrapper">
      <!-- Conversation List -->
      <div class="conversation-list">
        <div class="conversation-header">
          <h2>Tin nhắn</h2>
          <div class="conversation-header-actions">
            <button class="new-message-btn-all">
              <span>Tất cả</span>
            </button>
            <button class="new-message-btn">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-inbox-fill" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" class="size-5"><path fill-rule="evenodd" d="M15.4404 3.99993C16.2923 3.99993 16.9648 3.98626 17.5723 4.20208C18.0749 4.38074 18.5304 4.67215 18.9033 5.05364C19.3539 5.5147 19.6235 6.13085 19.9805 6.90423L21.6133 10.4423C21.7127 10.6578 21.8008 10.8448 21.8633 11.0449C21.9148 11.2099 21.9522 11.3793 21.9746 11.5507C22.0017 11.7586 22 11.9656 22 12.2031V12.5995C22 13.703 22.001 14.5914 21.9424 15.3085C21.8828 16.0372 21.7567 16.6773 21.4551 17.2695C20.9757 18.2103 20.2103 18.9756 19.2695 19.455C18.6773 19.7567 18.0373 19.8828 17.3086 19.9423C16.5914 20.0009 15.7032 19.9999 14.5996 19.9999H9.40038C8.29681 19.9999 7.40856 20.0009 6.6914 19.9423C5.96271 19.8828 5.32264 19.7567 4.73046 19.455C3.78969 18.9756 3.02427 18.2102 2.54491 17.2695C2.24331 16.6773 2.11714 16.0372 2.05761 15.3085C1.99903 14.5914 1.99999 13.703 1.99999 12.5995V12.2031C1.99999 11.9656 1.99826 11.7586 2.02538 11.5507C2.04778 11.3793 2.08518 11.2099 2.13671 11.0449C2.19921 10.8448 2.28724 10.6578 2.38671 10.4423L4.01952 6.90423C4.37646 6.13085 4.64607 5.5147 5.09667 5.05364C5.46957 4.67214 5.92506 4.38075 6.42773 4.20208C7.03521 3.98625 7.70771 3.99993 8.55956 3.99993H15.4404ZM4.00195 12.9999C4.00268 13.9265 4.00655 14.6038 4.05077 15.1454C4.10021 15.7505 4.19299 16.0989 4.32714 16.3622C4.6147 16.9264 5.0735 17.3852 5.63769 17.6728C5.90104 17.807 6.24934 17.8997 6.85448 17.9491C7.47128 17.9995 8.26396 17.9999 9.40038 17.9999H14.5996C15.736 17.9999 16.5287 17.9995 17.1455 17.9491C17.7507 17.8997 18.0989 17.807 18.3623 17.6728C18.9265 17.3852 19.3853 16.9264 19.6728 16.3622C19.807 16.0989 19.8998 15.7505 19.9492 15.1454C19.9934 14.6038 19.9973 13.9265 19.998 12.9999H17.4141L15.4141 14.9999H8.58593L6.58593 12.9999H4.00195ZM8.55956 5.99993C7.55771 5.99993 7.3024 6.01415 7.09765 6.08684C6.88222 6.16342 6.68617 6.2876 6.52636 6.4511C6.37445 6.60655 6.25594 6.83307 5.83593 7.74309L4.33202 10.9999H7.41405L9.41405 12.9999H14.5859L16.5859 10.9999H19.668L18.1641 7.74309C17.7441 6.83309 17.6255 6.60655 17.4736 6.4511C17.3138 6.28761 17.1178 6.16341 16.9023 6.08684C16.6976 6.01416 16.4422 5.99993 15.4404 5.99993H8.55956Z" clip-rule="evenodd"></path></svg>
            </button>
            <button class="new-message-btn" title="Tin nhắn mới">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-messages-plus-stroke" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" class="size-5"><path fill="currentColor" d="M19 17H22V19H19V22H17V19H14V17H17V14H19V17Z"></path><path fill="currentColor" d="M12.001 1.5C17.6164 1.5 22.2944 5.65131 22.6729 11H20.667C20.2911 6.83949 16.6 3.5 12.001 3.5C7.14663 3.50009 3.30282 7.2206 3.30273 11.7002V11.7148L3.30176 11.7295C3.28216 12.3963 3.39269 12.9535 3.55273 13.4961C3.63506 13.7752 3.7279 14.0415 3.82812 14.335C3.92548 14.62 4.02998 14.9299 4.11621 15.2529C4.29314 15.9158 4.39976 16.654 4.27148 17.5244C4.18582 18.1057 3.99734 18.7155 3.68945 19.3789C4.95409 19.7541 6.23939 19.4319 7.70312 18.7803L8.1582 18.5771L8.59473 18.8193C9.39946 19.2659 10.0788 19.6516 11 19.8154V21.8359C9.75387 21.6767 8.84349 21.237 8.05176 20.8047C6.17483 21.573 4.03099 22.0047 1.80566 20.7305L0.920898 20.2246L1.44434 19.3496C1.98449 18.446 2.21394 17.7687 2.29297 17.2324C2.37048 16.706 2.31264 16.252 2.18359 15.7686C2.11687 15.5187 2.033 15.2668 1.93555 14.9814C1.84088 14.7042 1.73188 14.3908 1.63477 14.0615C1.43592 13.3874 1.27508 12.612 1.30273 11.6709C1.31942 6.00245 6.15281 1.50009 12.001 1.5Z"></path></svg>
            </button>
          </div>
        </div>

        <div class="conversation-search">
          <div class="search-input-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-search-stroke" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" class="h-5 w-5 shrink-0 text-gray-700"><path d="M10.25 3.75c-3.59 0-6.5 2.91-6.5 6.5s2.91 6.5 6.5 6.5c1.795 0 3.419-.726 4.596-1.904 1.178-1.177 1.904-2.801 1.904-4.596 0-3.59-2.91-6.5-6.5-6.5zm-8.5 6.5c0-4.694 3.806-8.5 8.5-8.5s8.5 3.806 8.5 8.5c0 1.986-.682 3.815-1.824 5.262l4.781 4.781-1.414 1.414-4.781-4.781c-1.447 1.142-3.276 1.824-5.262 1.824-4.694 0-8.5-3.806-8.5-8.5z"></path></svg>
            <input type="text" placeholder="Tìm kiếm tin nhắn..." id="search-input">
          </div>
        </div>

        <div class="conversations">
          <% if (conversations && conversations.length > 0) { %>
            <% conversations.forEach(conv => { %>
              <% 
                const otherParticipant = conv.participants.find(p => p._id.toString() !== user._id.toString());
              %>
              <div class="conversation-item" data-conversation-id="<%= conv._id %>" onclick="loadConversation('<%= conv._id %>')">
                <div class="conversation-avatar">
                  <div class="avatar">
                    <% if (otherParticipant.avatar && otherParticipant.avatar.length > 0) { %>
                      <img src="<%= otherParticipant.avatar %>" style="width:100%;height:100%;border-radius:50%;object-fit:cover">
                    <% } else { %>
                      <%= otherParticipant.username.substring(0, 1).toUpperCase() %>
                    <% } %>
                  </div>
                </div>
                <div class="conversation-info">
                  <div class="conversation-name"><%= otherParticipant.username %></div>
                  <div class="conversation-preview">
                    <% if (conv.lastMessage) { %>
                      <% if (conv.lastMessage.sender._id.toString() === user._id.toString()) { %>
                        <span class="sender-label">Bạn:</span>
                      <% } %>
                      <span class="message-text"><%= conv.lastMessage.content ? conv.lastMessage.content.substring(0, 50) : '[Hình ảnh]' %></span>
                    <% } else { %>
                      <span class="message-text">Bắt đầu cuộc trò chuyện...</span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="no-conversations">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="empty-icon">
                <g><path d="M20.7 11.7c0-4.48-3.844-8.2-8.699-8.2-4.854 0-8.698 3.72-8.698 8.2v.015l-.001.014c-.02.667.09 1.225.25 1.767.083.28.176.545.276.839.098.285.202.595.288.918.177.663.284 1.401.156 2.271-.086.582-.274 1.191-.582 1.855 1.264.375 2.55.053 4.013-.599l.455-.203.437.242c1.07.594 1.917 1.08 3.406 1.08 4.855 0 8.7-3.72 8.7-8.199zm2 0c0 5.683-4.84 10.2-10.699 10.2-1.784 0-2.96-.555-3.95-1.095-1.876.768-4.02 1.2-6.245-.075l-.885-.505.524-.875c.54-.904.77-1.581.848-2.118.078-.526.02-.98-.11-1.463-.066-.25-.15-.502-.247-.788-.095-.277-.204-.59-.301-.92-.199-.674-.36-1.449-.332-2.39C1.322 6.002 6.154 1.5 12.002 1.5c5.859 0 10.7 4.518 10.7 10.2z"></path></g>
              </svg>
              <p>Không có tin nhắn nào</p>
              <p class="empty-hint">Bắt đầu một cuộc trò chuyện mới</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Message Area -->
      <div class="message-area">
        <div id="message-area-empty" class="message-area-empty">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="empty-icon">
            <g><path d="M20.7 11.7c0-4.48-3.844-8.2-8.699-8.2-4.854 0-8.698 3.72-8.698 8.2v.015l-.001.014c-.02.667.09 1.225.25 1.767.083.28.176.545.276.839.098.285.202.595.288.918.177.663.284 1.401.156 2.271-.086.582-.274 1.191-.582 1.855 1.264.375 2.55.053 4.013-.599l.455-.203.437.242c1.07.594 1.917 1.08 3.406 1.08 4.855 0 8.7-3.72 8.7-8.199zm2 0c0 5.683-4.84 10.2-10.699 10.2-1.784 0-2.96-.555-3.95-1.095-1.876.768-4.02 1.2-6.245-.075l-.885-.505.524-.875c.54-.904.77-1.581.848-2.118.078-.526.02-.98-.11-1.463-.066-.25-.15-.502-.247-.788-.095-.277-.204-.59-.301-.92-.199-.674-.36-1.449-.332-2.39C1.322 6.002 6.154 1.5 12.002 1.5c5.859 0 10.7 4.518 10.7 10.2z"></path></g>
          </svg>
          <p>Chọn một cuộc trò chuyện để xem tin nhắn</p>
        </div>

        <div id="message-area-content" class="message-area-content" style="display: none;">
          <div class="conversation-header-top">
            <div class="conversation-header-info">
              <div class="avatar" id="header-avatar"></div>
              <div>
                <h3 id="header-username"></h3>
              </div>
            </div>
            <button class="more-options-btn">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="icon">
                <g><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></g>
              </svg>
            </button>
          </div>

          <div class="messages-list" id="messages-list">
          </div>

          <div class="message-input-area">
            <div class="message-input-wrapper">
