<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thông báo</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/notifications.css">
</head>
<body>
<div class="wrap">
  <%- include('_header') %>
  <div class="main">
    <div class="feed">
      <div class="tab-bar">
        <div class="tabs">
          <div class="tab active">
            <span>Tất cả</span>
          </div>
          <div class="tab" id="tab-unread">
            <span>Chưa đọc</span>
          </div>
        </div>
      </div>

      <div class="notif-header">
        <button class="mark-all-read-btn" id="mark-all-read" onclick="markAllAsRead()">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </svg>
          <span>Đánh dấu tất cả đã đọc</span>
        </button>
      </div>

      <div id="notification-list"></div>
      <div id="load-more-container" style="display:none;text-align:center;padding:20px">
        <button class="load-more-btn" onclick="loadMoreNotifications()">Xem thêm</button>
      </div>
      <div id="empty-state" style="display:none" class="empty-state">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="#71767b">
          <path d="M19.993 9.042C19.48 5.017 16.054 2 11.996 2s-7.49 3.021-7.999 7.051L2.866 18H7.1c.463 2.282 2.481 4 4.9 4s4.437-1.718 4.9-4h4.236l-1.143-8.958zM12 20c-1.306 0-2.417-.835-2.829-2h5.658c-.412 1.165-1.523 2-2.829 2zm-6.866-4l.847-6.698C6.364 6.272 8.941 4 11.996 4s5.627 2.268 6.013 5.295L18.864 16H5.134z"/>
        </svg>
        <p>Chưa có thông báo nào</p>
      </div>
    </div>

    <div class="right-col">
      <div class="right-col-content">
        <div class="search-box">
          <div class="search-title">
            <div class="search-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><g><path d="M10.25 3.75c-3.59 0-6.5 2.91-6.5 6.5s2.91 6.5 6.5 6.5c1.795 0 3.419-.726 4.596-1.904 1.178-1.177 1.904-2.801 1.904-4.596 0-3.59-2.91-6.5-6.5-6.5zm-8.5 6.5c0-4.694 3.806-8.5 8.5-8.5s8.5 3.806 8.5 8.5c0 1.986-.682 3.815-1.824 5.262l4.781 4.781-1.414 1.414-4.781-4.781c-1.447 1.142-3.276 1.824-5.262 1.824-4.694 0-8.5-3.806-8.5-8.5z"></path></g></svg>
            </div>
            <input type="text" placeholder="Tìm kiếm">
          </div>
        </div>
        <div class="caigithe"></div>
        <div class="widget">
          <div class="widget-title">Xu hướng cho bạn</div>
          <div class="trend-item">
            <div class="trend-cat">Công nghệ · Xu hướng</div>
            <div class="trend-name">#AI2026</div>
            <div class="trend-count">52,4K bài đăng</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<template id="notification-template">
  <div class="notif-item" data-id="">
    <div class="notif-icon"></div>
    <div class="notif-body">
      <div class="notif-avatar"></div>
      <div class="notif-content">
        <div class="notif-text"></div>
        <div class="notif-time"></div>
      </div>
    </div>
    <button class="notif-delete" title="Xóa thông báo">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M10.59 12L4.54 5.96l1.42-1.42L12 10.59l6.04-6.05 1.42 1.42L13.41 12l6.05 6.04-1.42 1.42L12 13.41l-6.04 6.05-1.42-1.42L10.59 12z"/>
      </svg>
    </button>
  </div>
</template>

<script src="/public/js/notifications.js"></script>
</body>
</html>
