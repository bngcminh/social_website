<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập / Đăng Ký - Social Website</title>
    <link rel="stylesheet" href="/public/auth.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-box">
            <!-- Logo / Brand -->
            <div class="auth-header">
                <h1 class="brand-name">𝕏</h1>
                <h2 id="auth-title">Đăng Nhập</h2>
            </div>

            <!-- Login Form -->
            <form id="login-form" class="auth-form active" onsubmit="handleLogin(event)">
                <div class="form-group">
                    <input 
                        type="text" 
                        id="login-identifier" 
                        placeholder="Tên người dùng hoặc Email" 
                        required
                    >
                </div>
                <div class="form-group">
                    <input 
                        type="password" 
                        id="login-password" 
                        placeholder="Mật khẩu" 
                        required
                    >
                </div>
                <button type="submit" class="auth-btn" id="login-btn">Đăng Nhập</button>
                <div id="login-error" class="error-message"></div>
            </form>

            <!-- Signup Form -->
            <form id="signup-form" class="auth-form" onsubmit="handleRegister(event)">
                <div class="form-group">
                    <input 
                        type="text" 
                        id="signup-username" 
                        placeholder="Tên người dùng" 
                        required
                    >
                </div>
                <div class="form-group">
                    <input 
                        type="email" 
                        id="signup-email" 
                        placeholder="Email" 
                        required
                    >
                </div>
                <div class="form-group">
                    <input 
                        type="password" 
                        id="signup-password" 
                        placeholder="Mật khẩu (ít nhất 6 ký tự)" 
                        required
                    >
                </div>
                <div class="form-group">
                    <input 
                        type="password" 
                        id="signup-confirm-password" 
                        placeholder="Xác nhận mật khẩu" 
                        required
                    >
                </div>
                <button type="submit" class="auth-btn" id="signup-btn">Đăng Ký</button>
                <div id="signup-error" class="error-message"></div>
            </form>

            <!-- Toggle between Login and Signup -->
            <div class="auth-toggle">
                <p id="toggle-text">Chưa có tài khoản? <span id="toggle-btn" onclick="toggleForm()">Đăng ký ngay</span></p>
            </div>
        </div>

        <!-- Success Message -->
        <div id="success-modal" class="modal">
            <div class="modal-content">
                <h3 id="success-title">Thành công!</h3>
                <p id="success-message"></p>
                <button onclick="closeSuccessModal()" class="modal-btn">OK</button>
            </div>
        </div>
    </div>

    <script src="/public/auth.js"></script>
</body>
</html>
