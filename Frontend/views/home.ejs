
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Twitter/X UI Clone</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<div class="wrap">
  <%- include('_header') %>
  <div class="main">
    <div class="feed">
      <div class="tab-bar">
        <div class="tabs">
          <div class="tab active">
            <span>Dành cho bạn</span>
          </div>
          <div class="tab">
            <span>Đang theo dõi</span>
          </div>
        </div>
      </div>
      <div class="compose">
        <div class="compose-left">
          <div class="avatar"><%= user ? user.username.substring(0, 1).toUpperCase() : 'A' %></div>
        </div>
        <div class="compose-right">
          <div class="compose-input">
            <div id="compose-input" class="input-text" contenteditable="true" placeholder="Có gì mới vậy?!" data-placeholder="Có gì mới vậy?!" style="outline: none; min-height: 50px;"></div>
            <input type="file" id="file-input" accept="image/*,video/*" style="display:none">
          </div>
          <div id="image-preview" style="margin:12px 0;border-radius:16px;overflow:hidden;max-width:100%;display:none;position:relative">
            <img id="preview-img" src="" alt="Preview" style="width:100%;display:block;max-height:300px;object-fit:cover">
            <button type="button" onclick="clearPreview()" style="position:absolute;top:8px;right:8px;padding:4px 8px;background:rgba(0,0,0,0.7);color:white;border:none;border-radius:4px;cursor:pointer;font-size:12px">✕</button>
          </div>
          <div class="compose-actions">
            <div class="compose-icons">
              <nav class="icon-btn" title="Add image"> 
                <div class="icon-group">
                  <div class="icon-btn-content">
                    <button type="button" onclick="document.getElementById('file-input').click()">
                      <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                      fill="currentColor" viewBox="0 0 24 24" >
                      <path d="M5 21h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2m0-2v-1.59l3-3 1.29 1.29c.39.39 1.02.39 1.41 0l5.29-5.29 3 3V19h-14ZM19 5v5.59L16.71 8.3a.996.996 0 0 0-1.41 0l-5.29 5.29-1.29-1.29a.996.996 0 0 0-1.41 0l-2.29 2.29V5h14Z"></path><path d="M8.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 1 0 0-3"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="icon-btn-content">
                    <button>
                      <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                      fill="currentColor" viewBox="0 0 24 24" >
                      <path d="M12 18c4 0 5-4 5-4H7s1 4 5 4"></path><path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2m0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8"></path><path d="M8 10c.55 0 1 .45 1 1h2c0-1.65-1.35-3-3-3s-3 1.35-3 3h2c0-.55.45-1 1-1m5 1h2c0-.55.45-1 1-1s1 .45 1 1h2c0-1.65-1.35-3-3-3s-3 1.35-3 3"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="icon-btn-content">
                    <button>
                      <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                      fill="currentColor" viewBox="0 0 24 24" >
                      <path d="M16 10c0-2.21-1.79-4-4-4s-4 1.79-4 4 1.79 4 4 4 4-1.79 4-4m-6 0c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2"></path><path d="M11.42 21.81c.17.12.38.19.58.19s.41-.06.58-.19c.3-.22 7.45-5.37 7.42-11.82 0-4.41-3.59-8-8-8s-8 3.59-8 8c-.03 6.44 7.12 11.6 7.42 11.82M12 4c3.31 0 6 2.69 6 6 .02 4.44-4.39 8.43-6 9.74-1.61-1.31-6.02-5.29-6-9.74 0-3.31 2.69-6 6-6"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="icon-btn-content">
                    <button>
                      <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                      fill="currentColor" viewBox="0 0 24 24" >
                      <path d="M19 4h-2V2h-2v2H9V2H7v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2M5 20V8h14V6v14z"></path><path d="M7 11h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2zm-8 4h2v2H7zm4 0h2v2h-2zm4 0h2v2h-2z"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="icon-btn-content">
                    <button>
                      <svg fill="currentColor" fill-rule="evenodd" height="64" viewBox="0 0 24 24" width="64" xmlns="http://www.w3.org/2000/svg" style="flex: 0 0 auto; line-height: 1;"><title>Claude</title><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"></path></svg>
                    </button>
                  </div>
                </div>
              </nav>
              <button type="button" class="post-btn" id="post-btn" onclick="postTweet(event)" disabled>Đăng</button>
            </div>
          </div>
        </div>
      </div>
      <div id="feed-list"></div>
    </div>

    <div class="right-col">
      <div class="right-col-content">
        <div class="search-box">
          <div class="search-title">
            <div class="search-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1tjplnt r-1bwzh9t r-10ptun7 r-2dysd3 r-1janqcz"><g><path d="M10.25 3.75c-3.59 0-6.5 2.91-6.5 6.5s2.91 6.5 6.5 6.5c1.795 0 3.419-.726 4.596-1.904 1.178-1.177 1.904-2.801 1.904-4.596 0-3.59-2.91-6.5-6.5-6.5zm-8.5 6.5c0-4.694 3.806-8.5 8.5-8.5s8.5 3.806 8.5 8.5c0 1.986-.682 3.815-1.824 5.262l4.781 4.781-1.414 1.414-4.781-4.781c-1.447 1.142-3.276 1.824-5.262 1.824-4.694 0-8.5-3.806-8.5-8.5z"></path></g></svg>
            </div>
            <input type="text" placeholder="Tìm kiếm">
          </div>
        </div>
        <div class="caigithe"></div>
        <div class="widget">
          <div class="widget-title">Xu hướng cho bạn</div>
          <div class="trend-item">
            <div class="trend-cat">Công nghệ · Xu hướng</div>
            <div class="trend-name">#AI2026</div>
            <div class="trend-count">52,4K bài đăng</div>
          </div>
          <div class="trend-item">
            <div class="trend-cat">Việt Nam · Xu hướng</div>
            <div class="trend-name">#HàNội</div>
            <div class="trend-count">18,1K bài đăng</div>
          </div>
          <div class="trend-item">
            <div class="trend-cat">Thể thao · Xu hướng</div>
            <div class="trend-name">#V.League</div>
            <div class="trend-count">9,7K bài đăng</div>
          </div>
        </div>
        <div class="widget">
          <div class="widget-title">Gợi ý theo dõi</div>
          <div id="follow-list"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tweet Template -->
<template id="tweet-template">
  <div class="tweet">
    <div class="avatar"></div>
    <div class="tweet-body">
      <div class="tweet-meta">
        <div class="tweet-user">
          <span class="tweet-name"></span>
          <span class="tweet-handle"></span>
          <span class="tweet-time">· </span>
        </div>
        <div class="tweet-options">
          <svg fill="currentColor" fill-rule="evenodd" height="64" viewBox="0 0 24 24" width="64" xmlns="http://www.w3.org/2000/svg" style="flex: 0 0 auto; line-height: 1;"><title>Claude</title><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"></path></svg>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="r-4qtqp9 r-yyyyoo r-dnmrzs r-bnwqim r-lrvibr r-m6rgpd r-1xvli5t r-1hdv0qi"><g><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></g></svg>
        </div>
      </div>
      <div class="tweet-text"></div>
      <div class="tweet-image" style="margin-top:12px;border-radius:16px;overflow:hidden;max-width:100%">
        <img src="" alt="" style="width:100%;display:block;border-radius:16px;border:1px solid rgb(113, 118, 122);">
      </div>
      <div class="tweet-actions">
        <button class="act reply" data-action="reply">
          <svg viewBox="0 0 24 24" aria-hidden="true" style="width:1.25em;height:1.25em;display:inline-block;fill:currentColor;vertical-align:text-bottom"><g><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"></path></g></svg>
